{
  "$defs": {
    "DictationHandle": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Conversation Id",
          "type": "string"
        },
        "lease_id": {
          "format": "uuid",
          "title": "Lease Id",
          "type": "string"
        },
        "server_epoch": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Server Epoch",
          "type": "string"
        },
        "voice_session_id": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Voice Session Id",
          "type": "integer"
        }
      },
      "required": [
        "voice_session_id",
        "server_epoch",
        "lease_id",
        "conversation_id"
      ],
      "title": "DictationHandle",
      "type": "object"
    },
    "RealtimeSnapshot": {
      "additionalProperties": false,
      "properties": {
        "expires_in_ms": {
          "maximum": 120000,
          "minimum": 0,
          "title": "Expires In Ms",
          "type": "integer"
        },
        "handle": {
          "$ref": "#/$defs/DictationHandle"
        },
        "quiesced": {
          "title": "Quiesced",
          "type": "boolean"
        },
        "run_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9:_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run Id"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "state": {
          "maxLength": 80,
          "title": "State",
          "type": "string"
        },
        "transport": {
          "enum": [
            "openai_realtime",
            "gemini_live"
          ],
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "handle",
        "state",
        "quiesced",
        "expires_in_ms",
        "run_id",
        "transport"
      ],
      "title": "RealtimeSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "client_secret": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Client Secret"
    },
    "connection_seconds": {
      "default": 0,
      "maximum": 3600,
      "minimum": 0,
      "title": "Connection Seconds",
      "type": "integer"
    },
    "exchange_available": {
      "default": false,
      "title": "Exchange Available",
      "type": "boolean"
    },
    "model": {
      "default": "",
      "maxLength": 128,
      "title": "Model",
      "type": "string"
    },
    "secret_expires_in_ms": {
      "maximum": 60000,
      "minimum": 0,
      "title": "Secret Expires In Ms",
      "type": "integer"
    },
    "snapshot": {
      "$ref": "#/$defs/RealtimeSnapshot"
    }
  },
  "required": [
    "snapshot",
    "client_secret",
    "secret_expires_in_ms"
  ],
  "title": "RealtimeStart",
  "type": "object"
}
